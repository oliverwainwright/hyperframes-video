            </div>
            <div data-hf-id="hf-ovnn" class="legend">
              <div data-hf-id="hf-0nbc" class="lrow"><span data-hf-id="hf-0cit" class="dot" style="background: #6366f1"></span><span data-hf-id="hf-6a8h" class="name">AWS</span><span data-hf-id="hf-0lkn" class="val">28%</span></div>
              <div data-hf-id="hf-bwcg" class="lrow"><span data-hf-id="hf-yi2a" class="dot" style="background: #a5b4fc"></span><span data-hf-id="hf-93tj" class="name">Microsoft Azure</span><span data-hf-id="hf-2t2n" class="val">20%</span></div>
