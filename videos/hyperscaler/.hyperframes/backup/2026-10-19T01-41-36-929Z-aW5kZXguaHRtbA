            <div data-hf-id="hf-k4jo" class="seg-label" style="top: 1160px">Meta<span data-hf-id="hf-17jc" class="v">~$140B</span></div>
            <div data-hf-id="hf-u2xe" class="seg-label" style="top: 1022px">Microsoft<span data-hf-id="hf-yq60" class="v">~$175B</span></div>
            <div data-hf-id="hf-wphb" class="seg-label" style="top: 858px">Alphabet<span data-hf-id="hf-scoz" class="v">~$200B</span></div>
            <div data-hf-id="hf-owy6" class="seg-label" style="top: 676px">Amazon<span data-hf-id="hf-69jt" class="v">~$220B</span></div>

            <div data-hf-id="hf-380y" class="growth" id="s4-growth">+75%</div>

            <div data-hf-id="hf-i9g1" class="bar-cap" id="cap-2025" style="left: 120px; top: 1280px; width: 200px">2025</div>
            <div data-hf-id="hf-7rl7" class="bar-cap" id="cap-2026" style="left: 480px; top: 1280px; width: 210px">2026</div>
            <div data-hf-id="hf-d1u2" class="body" id="s4-src" style="top: 1380px; font-size: 30px; color: var(--muted)">Source: company capex guidance</div>
          </div>
        </div>
      </div>

      <!-- ================= Scene 5: CTA ================= -->
      <div data-hf-id="hf-ygxv" id="s5" class="scene clip" data-start="23.8" data-duration="6.2" data-track-index="4">
        <div data-hf-id="hf-ssje" class="si" id="s5-in">
          <div data-hf-id="hf-ihdp" class="glow" id="s5-glow" style="top: 120px"></div>
          <div data-hf-id="hf-x682" id="particles"></div>
          <div data-hf-id="hf-apeu" class="cta">
            <div data-hf-id="hf-p2jk" class="shot-wrap" id="s5-shot">
              <svg data-hf-id="hf-fvk1" id="ring" viewBox="0 0 440 440">
                <circle data-hf-id="hf-1vpr" cx="220" cy="220" r="212" fill="none" stroke="#6366f1" stroke-width="4" stroke-dasharray="44 18" stroke-linecap="round" />
              </svg>
              <div data-hf-id="hf-2ycw" class="shot"><img data-hf-id="hf-laiq" src="ow-headshot-bw.png" alt=""></div>
            </div>
            <div data-hf-id="hf-1ndk" class="cta-head" id="s5-head">The cloud is <span data-hf-id="hf-18bw" class="a">someone else's computer.</span></div>
            <div data-hf-id="hf-zk10" class="cta-sub" id="s5-sub">Follow for more AI &amp; tech explained in 30 seconds.</div>
            <svg data-hf-id="hf-0lmm" id="cloud-icon" viewBox="0 0 240 170">
              <path data-hf-id="hf-etd9" class="draw ic" pathLength="1" stroke="#a5b4fc" stroke-width="8" d="M 60 110 C 20 110, 20 56, 62 56 C 70 20, 130 14, 146 46 C 180 32, 214 60, 200 92 C 222 98, 218 110, 196 110 Z" />
              <path data-hf-id="hf-2k0w" class="draw ic" pathLength="1" stroke="#22c55e" stroke-width="7" d="M 92 128 L 148 128 L 148 162 L 92 162 Z" />
              <path data-hf-id="hf-rods" class="draw ic" pathLength="1" stroke="#22c55e" stroke-width="6" d="M 120 110 L 120 128" />
            </svg>
            <div data-hf-id="hf-08bb" class="tag mono" id="s5-tag">NEW TECH, DECODED IN 30s</div>
          </div>
        </div>
      </div>

      <audio data-hf-id="hf-iej6" id="bgm" src="technological-progress.mp3" data-start="0" data-duration="30" data-track-index="9" data-volume="0.35" data-fade-in="0.4" data-fade-out="0.6"></audio>
    </div>

    <script>
      const tl = gsap.timeline({ paused: true });
      const S = [0, 5.8, 11.8, 17.8, 23.8]; // scene starts (0.4s overlaps)
      const XF = 0.4; // crossfade
      const E = "power3.out";

      // Shared: rise-in helper, crossfades, ambient glow breath + ghost drift
      const rise = (t, sel, at, y = 40, d = 0.6) =>
        tl.fromTo(sel, { opacity: 0, y }, { opacity: 1, y: 0, duration: d, ease: E }, at);
      for (let i = 1; i < 5; i++) {
        tl.to(`#s${i}-in`, { opacity: 0, duration: XF, ease: "power2.inOut" }, S[i]);
        tl.fromTo(`#s${i + 1}-in`, { opacity: 0 }, { opacity: 1, duration: XF, ease: "power2.inOut" }, S[i]);
      }
      for (let i = 1; i <= 5; i++) {
        const len = i === 5 ? 6.2 : 6.4;
        tl.fromTo(`#s${i}-glow`, { scale: 0.92 }, { scale: 1.08, duration: len / 4, ease: "sine.inOut", yoyo: true, repeat: 3 }, S[i - 1]);
        const g = document.getElementById(`s${i}-ghost`);
        if (g) tl.fromTo(g, { x: 80 }, { x: -80, duration: len, ease: "none" }, S[i - 1]);
      }

      // ---------- Scene 1: avatar-cloud-network + center-outward-expansion ----------
      {
        const t = S[0];
        rise(tl, "#s1-head", t + 0.1);
        tl.fromTo("#s1-phone", { opacity: 0, scale: 0.6 }, { opacity: 1, scale: 1, duration: 0.6, ease: E }, t + 0.3);
        const C = { x: 480, y: 720 };
        const N = 8;
        const R = 300;
        const svg = document.getElementById("s1-lines");
        const racks = document.getElementById("s1-racks");
        for (let i = 0; i < N; i++) {
          const a = (i / N) * Math.PI * 2 - Math.PI / 2;
          const x = C.x + Math.cos(a) * R;
          const y = C.y + Math.sin(a) * R;
          const ln = document.createElementNS("http://www.w3.org/2000/svg", "line");
          Object.entries({ x1: C.x, y1: C.y, x2: x, y2: y, stroke: "#6366f1", "stroke-width": 5, pathLength: 1, class: "draw s1-ln" }).forEach(([k, v]) => ln.setAttribute(k, v));
          svg.appendChild(ln);
          const r = document.createElement("div");
          r.className = "rack s1-rack";
          r.style.left = `${x - 52}px`;
          r.style.top = `${y - 62}px`;
          r.innerHTML =
            '<svg viewBox="0 0 104 124" width="104" height="124"><rect x="4" y="4" width="96" height="116" rx="14" fill="#14142a" stroke="#ffffff" stroke-width="5"/>' +
            [0, 1, 2].map((k) => `<rect x="18" y="${20 + k * 32}" width="52" height="16" rx="5" fill="#6366f1"/><circle cx="84" cy="${28 + k * 32}" r="6" fill="#22c55e"/>`).join("") +
            "</svg>";
          racks.appendChild(r);
        }
        tl.to(".s1-ln", { strokeDashoffset: 0, duration: 0.7, ease: "power2.out", stagger: 0.06 }, t + 0.8);
        tl.fromTo(".s1-rack", { opacity: 0, scale: 0.4 }, { opacity: 1, scale: 1, duration: 0.6, ease: E, stagger: 0.06 }, t + 1.1);
        // Mini-rack grid expands outward from center
        const grid = document.getElementById("s1-grid");
        for (let i = 0; i < 30; i++) {
          const m = document.createElement("div");
          m.className = "mini s1-mini";
          grid.appendChild(m);
        }
        tl.fromTo(".s1-mini", { opacity: 0, scale: 0.3 }, { opacity: 1, scale: 1, duration: 0.5, ease: E, stagger: { each: 0.016, from: "center" } }, t + 2.3);
        rise(tl, "#s1-body", t + 3.0, 24);
      }

      // ---------- Scene 2: ring fill + counting-dynamic-scale ----------
      {
        const t = S[1];
        rise(tl, "#s2-head", t + 0.25);
        const arcs = [
          ["#arc-aws", 0.274],
          ["#arc-azure", 0.194],
          ["#arc-gcp", 0.144],
        ];
        arcs.forEach(([id, p], i) => tl.fromTo(id, { attr: { "stroke-dasharray": "0 1" } }, { attr: { "stroke-dasharray": `${p} 1` }, duration: 0.8, ease: "power2.out" }, t + 0.7 + i * 0.35));
        const st = { v: 0 };
        const el = document.getElementById("s2-count");
        tl.fromTo(st, { v: 0 }, { v: 63, duration: 1.6, ease: "power2.out", onUpdate: () => (el.textContent = Math.round(st.v)) }, t + 0.7);
        tl.fromTo("#s2-count", { scale: 0.6 }, { scale: 1, duration: 1.6, ease: "power2.out" }, t + 0.7);
        rise(tl, "#s2-pct", t + 2.2, 16, 0.4);
        rise(tl, "#s2-dl", t + 0.9, 12, 0.5);
        tl.fromTo(".lrow", { opacity: 0, x: -50 }, { opacity: 1, x: 0, duration: 0.5, ease: E, stagger: 0.3 }, t + 1.0);
        rise(tl, "#s2-also", t + 2.8, 24);
      }

      // ---------- Scene 3: svg-path-draw traffic spike + server count ----------
      {
        const t = S[2];
        rise(tl, "#s3-head", t + 0.25);
        tl.fromTo("#s3-panel", { opacity: 0, y: 40 }, { opacity: 1, y: 0, duration: 0.6, ease: E }, t + 0.45);
        tl.to("#traffic-line", { strokeDashoffset: 0, duration: 2.0, ease: "power2.inOut" }, t + 0.8);
        tl.fromTo("#spike-dot", { opacity: 0, scale: 0, transformOrigin: "50% 50%" }, { opacity: 1, scale: 1, duration: 0.4, ease: E }, t + 1.8);
        tl.fromTo(".srv.base", { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.5, ease: E, stagger: 0.1 }, t + 0.7);
        rise(tl, "#s3-label", t + 0.8, 16, 0.5);
        tl.fromTo(".srv.up", { opacity: 0, y: 40, scale: 0.6 }, { opacity: 1, y: 0, scale: 1, duration: 0.45, ease: E, stagger: 0.1 }, t + 1.6);
        const st = { v: 2 };
        const el = document.getElementById("s3-count");
        tl.fromTo(st, { v: 2 }, { v: 8, duration: 0.9, ease: "power2.out", onUpdate: () => (el.textContent = Math.round(st.v)) }, t + 1.6);
        tl.to(".srv.up", { opacity: 0.12, y: 30, duration: 0.45, ease: "power2.in", stagger: { each: 0.08, from: "end" } }, t + 3.6);
        tl.to(st, { v: 2, duration: 0.8, ease: "power2.out", onUpdate: () => (el.textContent = Math.round(st.v)) }, t + 3.6);
        tl.fromTo("#s3-pill", { opacity: 0, scale: 0.85 }, { opacity: 1, scale: 1, duration: 0.5, ease: E }, t + 4.1);
        rise(tl, "#s3-body", t + 4.5, 20);
      }

      // ---------- Scene 4: counting-dynamic-scale + growth bars ----------
      {
        const t = S[3];
        rise(tl, "#s4-head", t + 0.25);
        const st = { v: 0 };
        const el = document.getElementById("s4-count");
        tl.fromTo(st, { v: 0 }, { v: 700, duration: 1.8, ease: "power2.out", onUpdate: () => (el.textContent = "$" + Math.round(st.v)) }, t + 0.6);
        tl.fromTo("#s4-count", { scale: 0.55 }, { scale: 1, duration: 1.8, ease: "power2.out" }, t + 0.6);
        tl.fromTo("#s4-suffix", { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.4, ease: E }, t + 2.4);
        rise(tl, "#s4-sub", t + 0.9, 12, 0.5);
        rise(tl, "#cap-2025", t + 1.0, 12, 0.4);
        rise(tl, "#cap-2026", t + 1.2, 12, 0.4);
        tl.fromTo("#bar-2025", { scaleY: 0 }, { scaleY: 1, duration: 0.7, ease: E }, t + 1.1);
        rise(tl, "#cap-2025v", t + 1.6, 12, 0.4);
        tl.fromTo(".seg", { scaleY: 0 }, { scaleY: 1, duration: 0.5, ease: E, stagger: 0.3 }, t + 1.5);
        tl.fromTo(".seg-label", { opacity: 0, x: -24 }, { opacity: 1, x: 0, duration: 0.45, ease: E, stagger: 0.3 }, t + 1.7);
        tl.fromTo("#s4-growth", { opacity: 0, scale: 0.7 }, { opacity: 1, scale: 1, duration: 0.5, ease: E }, t + 3.2);
        rise(tl, "#s4-src", t + 3.6, 12, 0.5);
      }

      // ---------- Scene 5: CTA + particles ----------
      {
        const t = S[4];
        // seeded PRNG (mulberry32) — deterministic particle field
        let seed = 7;
        const rnd = () => {
          seed |= 0;
          seed = (seed + 0x6d2b79f5) | 0;
          let r = Math.imul(seed ^ (seed >>> 15), 1 | seed);
          r = (r + Math.imul(r ^ (r >>> 7), 61 | r)) ^ r;
          return ((r ^ (r >>> 14)) >>> 0) / 4294967296;
        };
        const field = document.getElementById("particles");
        for (let i = 0; i < 12; i++) {
          const p = document.createElement("div");
          const size = 10 + rnd() * 22;
          p.className = "particle";
          p.style.width = p.style.height = `${size}px`;
          p.style.left = `${rnd() * 1040}px`;
          p.style.top = `${700 + rnd() * 1300}px`;
          p.style.background = rnd() > 0.5 ? "#6366f1" : "#ffffff";
          field.appendChild(p);
          const o = 0.08 + rnd() * 0.18;
          tl.fromTo(p, { y: 0, opacity: 0 }, { y: -(700 + rnd() * 700), opacity: o, duration: 6.2, ease: "none" }, t);
        }
        tl.fromTo("#s5-shot", { opacity: 0, scale: 0.7 }, { opacity: 1, scale: 1, duration: 0.8, ease: E }, t + 0.3);
        tl.fromTo("#ring", { rotation: 0, transformOrigin: "50% 50%" }, { rotation: 60, duration: 5.9, ease: "none" }, t + 0.3);
        rise(tl, "#s5-head", t + 0.7);
        rise(tl, "#s5-sub", t + 1.1, 24);
        tl.to("#cloud-icon .ic", { strokeDashoffset: 0, duration: 0.8, ease: "power2.out", stagger: 0.25 }, t + 1.5);
        tl.fromTo("#s5-tag", { opacity: 0, scale: 0.85 }, { opacity: 1, scale: 1, duration: 0.5, ease: E }, t + 2.4);
      }

      window.__timelines["main"] = tl;
      tl.seek(0);
    </script>
