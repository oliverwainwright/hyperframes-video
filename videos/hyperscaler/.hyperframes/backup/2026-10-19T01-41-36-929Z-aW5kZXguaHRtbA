<!DOCTYPE html>
<html lang="en" data-resolution="portrait">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=1080, height=1920">
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
    <style>
      :root {
        --bg: #0a0a0a;
        --fg: #ffffff;
        --dim: #a3a3b8;
        --muted: #6b6b80;
        --accent: #6366f1;
        --accent-hi: #a5b4fc;
        --success: #22c55e;
        --panel: #111118;
        --line: #26263a;
      }
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        width: 1080px;
        height: 1920px;
        overflow: hidden;
        background: var(--bg);
      }
      #root {
        position: relative;
        width: 100%;
        height: 100%;
        background: var(--bg);
        color: var(--fg);
        font-family: "Inter", sans-serif;
      }
      .mono {
        font-family: "JetBrains Mono", monospace;
      }
      .scene {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
      }
      .si {
        position: absolute;
        inset: 0;
      }
      /* Safe zone: top 150, bottom 170, sides 60 → 960 x 1600 box */
      .safe {
        position: absolute;
        left: 60px;
        top: 150px;
        width: 960px;
        height: 1600px;
      }
      .glow {
        position: absolute;
        width: 1100px;
        height: 1100px;
        left: -10px;
        top: 420px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(99, 102, 241, 0.22) 0%, rgba(99, 102, 241, 0) 65%);
      }
      .ghost {
        position: absolute;
        left: 0;
        width: 1080px;
        text-align: center;
        font-weight: 900;
        font-size: 300px;
        letter-spacing: -12px;
        color: rgba(99, 102, 241, 0.1);
        white-space: nowrap;
      }
      .headline {
        position: absolute;
        left: 0;
        top: 10px;
        width: 960px;
        text-align: center;
        font-weight: 900;
        font-size: 84px;
        line-height: 1.04;
        letter-spacing: -2.5px;
      }
      .headline .l {
        display: block;
      }
      .headline .a {
        color: var(--accent);
      }
      .body {
        position: absolute;
        left: 0;
        width: 960px;
        text-align: center;
        font-size: 38px;
        font-weight: 400;
        color: var(--dim);
        line-height: 1.3;
      }
      .body b {
        color: var(--fg);
        font-weight: 700;
      }
      .draw {
        fill: none;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-dasharray: 1;
        stroke-dashoffset: 1;
      }

      /* ---------- Scene 1 ---------- */
      #s1-lines {
        position: absolute;
        left: 0;
        top: 0;
        width: 960px;
        height: 1600px;
      }
      .phone {
        position: absolute;
        left: 405px;
        top: 590px;
        width: 150px;
        height: 260px;
        border-radius: 28px;
        border: 6px solid var(--fg);
        background: #15152a;
        box-shadow: 0 0 60px rgba(99, 102, 241, 0.5);
      }
      .phone .screen {
        position: absolute;
        inset: 18px 12px 34px 12px;
        border-radius: 10px;
        background: linear-gradient(180deg, #4f46e5, #312e81);
      }
      .phone .btn {
        position: absolute;
        left: 55px;
        bottom: 10px;
        width: 28px;
        height: 8px;
        border-radius: 4px;
        background: var(--fg);
      }
      .rack {
        position: absolute;
        width: 104px;
        height: 124px;
      }
      .mini-grid {
        position: absolute;
        left: 0;
        top: 1120px;
        width: 960px;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 14px;
      }
      .mini {
        width: 70px;
        height: 46px;
        border-radius: 8px;
        border: 3px solid var(--accent);
        background: rgba(99, 102, 241, 0.16);
        position: relative;
      }
      .mini::after {
        content: "";
        position: absolute;
        right: 8px;
        top: 15px;
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: var(--success);
      }

      /* ---------- Scene 2 ---------- */
      #donut {
        position: absolute;
        left: 210px;
        top: 360px;
        width: 540px;
        height: 540px;
      }
      .donut-center {
        position: absolute;
        left: 210px;
        top: 360px;
        width: 540px;
        height: 540px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
      }
      .pct-wrap {
        display: flex;
        align-items: baseline;
        justify-content: center;
        width: 360px;
      }
      #s2-count {
        display: inline-block;
        font-size: 150px;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        letter-spacing: -6px;
        transform-origin: center center;
      }
      .pct-sign {
        display: inline-block;
        font-size: 80px;
        font-weight: 700;
        color: var(--accent-hi);
      }
      .donut-label {
        font-size: 32px;
        font-weight: 700;
        color: var(--dim);
      }
      .legend {
        position: absolute;
        left: 160px;
        top: 960px;
        width: 640px;
        display: flex;
        flex-direction: column;
        gap: 22px;
      }
      .lrow {
        display: flex;
        align-items: center;
        gap: 24px;
        font-size: 42px;
        font-weight: 700;
      }
      .lrow .dot {
        width: 34px;
        height: 34px;
        border-radius: 10px;
      }
      .lrow .name {
        flex: 1;
      }
      .lrow .val {
        font-family: "JetBrains Mono", monospace;
        font-variant-numeric: tabular-nums;
      }
      .also {
        position: absolute;
        left: 0;
        top: 1260px;
        width: 960px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 18px;
        font-size: 36px;
        color: var(--dim);
      }
      .chip {
        padding: 12px 28px;
        border-radius: 999px;
        border: 3px solid var(--fg);
        color: var(--fg);
        font-weight: 700;
        font-size: 36px;
      }

      /* ---------- Scene 3 ---------- */
      .panel {
        position: absolute;
        left: 0;
        top: 280px;
        width: 960px;
        height: 560px;
        border-radius: 32px;
        background: var(--panel);
        border: 3px solid var(--line);
      }
      .panel-label {
        position: absolute;
        left: 36px;
        top: 26px;
        font-size: 30px;
        font-weight: 700;
        color: var(--dim);
        letter-spacing: 2px;
      }
      #traffic {
        position: absolute;
        left: 0;
        top: 0;
        width: 960px;
        height: 560px;
      }
      .servers {
        position: absolute;
        left: 0;
        top: 890px;
        width: 960px;
        display: flex;
        justify-content: center;
        gap: 20px;
      }
      .srv {
        width: 90px;
        height: 90px;
        border-radius: 18px;
        border: 4px solid var(--success);
        background: rgba(34, 197, 94, 0.16);
        position: relative;
      }
      .srv.base {
        border-color: var(--accent);
        background: rgba(99, 102, 241, 0.2);
      }
      .srv::before,
      .srv::after {
        content: "";
        position: absolute;
        left: 14px;
        right: 14px;
        height: 6px;
        border-radius: 3px;
        background: currentColor;
        opacity: 0.8;
      }
      .srv {
        color: var(--success);
      }
      .srv.base {
        color: var(--accent-hi);
      }
      .srv::before {
        top: 26px;
      }
      .srv::after {
        top: 50px;
      }
      .srv-count {
        position: absolute;
        left: 0;
        top: 1020px;
        width: 960px;
        text-align: center;
        font-size: 40px;
        font-weight: 700;
        color: var(--dim);
      }
      #s3-count {
        display: inline-block;
        width: 70px;
        text-align: center;
        font-size: 64px;
        color: var(--fg);
        font-variant-numeric: tabular-nums;
      }
      .pill {
        position: absolute;
        left: 0;
        top: 1150px;
        width: 960px;
        display: flex;
        justify-content: center;
      }
      .pill span {
        padding: 18px 40px;
        border-radius: 999px;
        background: rgba(34, 197, 94, 0.16);
        border: 3px solid var(--success);
        color: var(--success);
        font-size: 40px;
        font-weight: 700;
      }

      /* ---------- Scene 4 ---------- */
      .big-wrap {
        position: absolute;
        left: 0;
        top: 250px;
        width: 960px;
        display: flex;
        align-items: baseline;
        justify-content: center;
      }
      #s4-count {
        display: inline-block;
        font-size: 170px;
        font-weight: 700;
        letter-spacing: -8px;
        font-variant-numeric: tabular-nums;
        transform-origin: center bottom;
      }
      .big-suffix {
        display: inline-block;
        font-size: 120px;
        font-weight: 700;
        color: var(--accent-hi);
      }
      .bar {
        position: absolute;
        transform-origin: bottom center;
        border-radius: 10px;
      }
      .bar-cap {
        position: absolute;
        font-size: 38px;
        font-weight: 700;
        text-align: center;
      }
      .seg-label {
        position: absolute;
        left: 712px;
        width: 248px;
        font-size: 30px;
        font-weight: 700;
        line-height: 1.15;
      }
      .seg-label .v {
        display: block;
        font-family: "JetBrains Mono", monospace;
        color: var(--dim);
        font-size: 30px;
      }
      .growth {
        position: absolute;
        left: 330px;
        top: 760px;
        width: 150px;
        padding: 10px 0;
        border-radius: 999px;
        background: rgba(34, 197, 94, 0.16);
        border: 3px solid var(--success);
        color: var(--success);
        font-size: 36px;
        font-weight: 700;
        text-align: center;
      }

      /* ---------- Scene 5 ---------- */
      .particle {
        position: absolute;
        border-radius: 50%;
      }
      .cta {
        position: absolute;
        left: 60px;
        top: 330px;
        width: 960px;
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      .shot-wrap {
        position: relative;
        width: 440px;
        height: 440px;
      }
      #ring {
        position: absolute;
        left: 0;
        top: 0;
        width: 440px;
        height: 440px;
      }
      .shot {
        position: absolute;
        left: 30px;
        top: 30px;
        width: 380px;
        height: 380px;
        border-radius: 50%;
        overflow: hidden;
        border: 5px solid var(--accent);
        box-shadow: 0 30px 80px rgba(99, 102, 241, 0.4), 0 0 0 10px var(--bg);
      }
      .shot img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
      .cta-head {
        margin-top: 60px;
        width: 960px;
        text-align: center;
        font-size: 80px;
        font-weight: 900;
        line-height: 1.05;
        letter-spacing: -2.5px;
      }
      .cta-head .a {
        color: var(--accent);
      }
      .cta-sub {
        margin-top: 34px;
        width: 760px;
        text-align: center;
        font-size: 40px;
        color: var(--dim);
        line-height: 1.3;
      }
      #cloud-icon {
        margin-top: 60px;
        width: 240px;
        height: 170px;
      }
      .tag {
        margin-top: 50px;
        padding: 16px 34px;
        border-radius: 999px;
        border: 3px solid var(--accent);
        background: rgba(99, 102, 241, 0.16);
        color: var(--accent-hi);
        font-size: 30px;
        font-weight: 700;
        letter-spacing: 1px;
      }
    </style>
  </head>
  <body>
    <div data-hf-id="hf-coex" id="root" data-composition-id="main" data-start="0" data-duration="30" data-width="1080" data-height="1920">
      <!-- ================= Scene 1: landlords of the internet ================= -->
      <div data-hf-id="hf-rcr6" id="s1" class="scene clip" data-start="0" data-duration="6.2" data-track-index="0">
        <div data-hf-id="hf-f5um" class="si" id="s1-in">
          <div data-hf-id="hf-fssp" class="glow" id="s1-glow"></div>
          <div data-hf-id="hf-zbmn" class="safe">
            <div data-hf-id="hf-87d9" class="headline" id="s1-head">
              <span data-hf-id="hf-53gx" class="l">The landlords</span>
              <span data-hf-id="hf-0fb5" class="l a">of the internet.</span>
            </div>
            <svg data-hf-id="hf-jnwn" id="s1-lines" viewBox="0 0 960 1600" />
            <div data-hf-id="hf-h9ae" id="s1-racks"></div>
            <div data-hf-id="hf-njsl" class="phone" id="s1-phone"><div data-hf-id="hf-cdmk" class="screen"></div><div data-hf-id="hf-spj4" class="btn"></div></div>
            <div data-hf-id="hf-qu1l" class="mini-grid" id="s1-grid"></div>
            <div data-hf-id="hf-scqe" class="body" id="s1-body" style="top: 1430px">
              <b data-hf-id="hf-hdsl">Millions of servers</b> in data centers worldwide, rented by the hour.
            </div>
          </div>
        </div>
      </div>

      <!-- ================= Scene 2: who they are ================= -->
      <div data-hf-id="hf-sn1f" id="s2" class="scene clip" data-start="5.8" data-duration="6.4" data-track-index="1">
        <div data-hf-id="hf-686n" class="si" id="s2-in">
          <div data-hf-id="hf-c6p0" class="glow" id="s2-glow"></div>
          <div data-hf-id="hf-wcrx" class="ghost" id="s2-ghost" aria-hidden="true" data-layout-ignore="" style="top: 1420px">BIG 3</div>
          <div data-hf-id="hf-nz8f" class="safe">
            <div data-hf-id="hf-iajg" class="headline" id="s2-head">
              <span data-hf-id="hf-utm7" class="l">Three companies run</span>
              <span data-hf-id="hf-izte" class="l a">most of the cloud.</span>
            </div>
            <svg data-hf-id="hf-sztb" id="donut" viewBox="0 0 540 540">
              <g data-hf-id="hf-fk7e" transform="rotate(-90 270 270)">
                <circle data-hf-id="hf-zgcd" cx="270" cy="270" r="230" fill="none" stroke="#1c1c2b" stroke-width="64" />
