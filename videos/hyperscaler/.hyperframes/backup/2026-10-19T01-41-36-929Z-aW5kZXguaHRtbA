                <circle data-hf-id="hf-5hf7" id="arc-azure" cx="270" cy="270" r="230" fill="none" stroke="#a5b4fc" stroke-width="64" pathLength="1" stroke-dasharray="0 1" stroke-dashoffset="-0.28" />
